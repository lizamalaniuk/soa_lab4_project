
FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir \
    "a2a-sdk>=1,<2" \
    "uvicorn>=0.34,<1" \
    "starlette>=0.40,<1" \
    "sse-starlette>=2,<4" \
    "httpx>=0.27,<1" \
    "redis>=5,<7"

COPY a2a_agents/ ./a2a_agents/

ENV PYTHONUNBUFFERED=1

CMD ["python", "-m", "a2a_agents.producer_agent"]
